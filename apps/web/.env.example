# ── Stripe (required for card-add / Apple Pay) ───────────────────────────────
# Publishable key — safe for the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — SERVER-SIDE ONLY. Never use NEXT_PUBLIC_ prefix here.
# Rotate immediately if accidentally committed or logged.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from the Stripe dashboard or `stripe listen` CLI output.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email / Auth ──────────────────────────────────────────────────────────────
# Postmark server token (server-side only — never expose to the browser)
POSTMARK_SERVER_TOKEN=

# Sender address for auth / transactional emails
AUTH_FROM_EMAIL=noreply@use-onecard.com

# Session signing secret — minimum 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ── Waitlist webhook ──────────────────────────────────────────────────────────
WAITLIST_WEBHOOK_URL=

# ── Logo / Brand APIs ─────────────────────────────────────────────────────────
# Logo.dev publishable token (public in image URLs)
NEXT_PUBLIC_LOGODEV_TOKEN=
LOGODEV_TOKEN=

# Brandfetch Logo API client ID (public — embedded in img URLs, free CDN tier)
# Get from https://developers.brandfetch.com — NOT the same as the Brand API bearer key
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# Brand API bearer key (optional — only for one-off scripts; NOT used at runtime)
BRANDFETCH_KEY=

# Rewards Credit Card API (RapidAPI) — https://rapidapi.com/rewardsccapi/api/rewards-credit-card-api
# Used for real card art in the wallet via GET /creditcard-card-image/{cardKey}
REWARDS_CC_RAPIDAPI_KEY=

# Card Finder (US) — optional override for structured sign-up bonus JSON feed
# Default: https://raw.githubusercontent.com/andenacitelli/credit-card-bonuses-api/main/exports/data.json
CARD_BONUSES_API_URL=

# ── Rewards-Intelligence Hub (backend; UI is feature-flagged OFF) ────────────
# The hub UI ships OFF so the public site is unchanged. Set to 1 to enable the
# /hub route + nav entry. Leave unset/0 for the public build.
NEXT_PUBLIC_HUB_UI=

# Local-only demo profile auth for the hub. This is ignored in production and
# should stay unset in deployed environments unless real auth has been added.
HUB_DEMO_AUTH_ENABLED=

# Bank-data provider. The DEFAULT is "mock" — the hub runs end-to-end with NO
# third-party keys (local fixtures). Set to "plaid" to use real Plaid Sandbox.
DATA_PROVIDER=mock

# ── Plaid provider (only needed when DATA_PROVIDER=plaid) ─────────────────────
# Start with Sandbox. Link's documented test credentials are user_good / pass_good.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# Public HTTPS endpoint a provider calls back, e.g.
#   https://<host>/api/hub/webhook/plaid
# Optional for local linking; required to receive webhooks in a deployed env.
# (HUB_WEBHOOK_URL is preferred; PLAID_WEBHOOK_URL is still read as a fallback.)
HUB_WEBHOOK_URL=
PLAID_WEBHOOK_URL=

# Optional HMAC secret for verifying mock-provider webhooks in dev/tests.
MOCK_WEBHOOK_SECRET=

# Freshness threshold in hours; data older than this is marked "stale" and shown
# as last-known, never as live. Defaults to 24.
HUB_FRESHNESS_HOURS=24

# SERVER-SIDE ONLY AES-256 key for provider access tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_ENCRYPTION_KEY=
