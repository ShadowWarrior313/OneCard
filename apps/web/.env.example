# ── Stripe (required for card-add / Apple Pay) ───────────────────────────────
# Publishable key — safe for the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — SERVER-SIDE ONLY. Never use NEXT_PUBLIC_ prefix here.
# Rotate immediately if accidentally committed or logged.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from the Stripe dashboard or `stripe listen` CLI output.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email / Auth ──────────────────────────────────────────────────────────────
# Postmark server token (server-side only — never expose to the browser)
POSTMARK_SERVER_TOKEN=

# Sender address for auth / transactional emails
AUTH_FROM_EMAIL=noreply@use-onecard.com

# Session signing secret — minimum 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ── Waitlist webhook ──────────────────────────────────────────────────────────
WAITLIST_WEBHOOK_URL=

# ── Logo / Brand APIs ─────────────────────────────────────────────────────────
# Logo.dev publishable token (public in image URLs)
NEXT_PUBLIC_LOGODEV_TOKEN=
LOGODEV_TOKEN=

# Brandfetch Logo API client ID (public — embedded in img URLs, free CDN tier)
# Get from https://developers.brandfetch.com — NOT the same as the Brand API bearer key
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# Brand API bearer key (optional — only for one-off scripts; NOT used at runtime)
BRANDFETCH_KEY=

# Rewards Credit Card API (RapidAPI) — https://rapidapi.com/rewardsccapi/api/rewards-credit-card-api
# Used for real card art in the wallet via GET /creditcard-card-image/{cardKey}
REWARDS_CC_RAPIDAPI_KEY=

# Card Finder (US) — optional override for structured sign-up bonus JSON feed
# Default: https://raw.githubusercontent.com/andenacitelli/credit-card-bonuses-api/main/exports/data.json
CARD_BONUSES_API_URL=
